                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "1F79EDC92CC0A25D0079088B"
                     BuildableName = "OneByte.app"
                     BlueprintName = "OneByte"
                     ReferencedContainer = "container:OneByte.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
